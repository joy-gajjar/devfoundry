{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevFoundry",
  "version": "0.1.0",
  "identifier": "com.joygajjar.devfoundry",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ..",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"title": "DevFoundry", "width": 1440, "height": 900, "minWidth": 960, "minHeight": 640}],
    "security": {"csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:*; style-src 'self' 'unsafe-inline'; script-src 'self'"}
  },
  "bundle": {"active": false, "icon": []}
}
